<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: что НЕ попадает в облачную копию и перенос на новый телефон. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
