    {
      "id": "acquaintance",
      "title": {
        "ru": "Знакомство",
        "en": "Getting acquainted"
      },
      "items": [
        {
          "sah": "Эн аатыҥ кимий?",
          "tr": {
            "ru": "Как тебя зовут?",
            "en": "What is your name?"
          }
        },
        {
          "sah": "Мин аатым …",
          "tr": {
            "ru": "Меня зовут …",
            "en": "My name is …"
          }
        },
        {
          "sah": "Хайдах олороҕун?",
          "tr": {
            "ru": "Как поживаешь?",
            "en": "How are you?"
          }
        },
        {
          "sah": "Үчүгэй.",
          "tr": {
            "ru": "Хорошо.",
            "en": "Fine."
          }
        },
        {
          "sah": "Мин сахалыы үөрэнэбин.",
          "tr": {
            "ru": "Я учу якутский язык.",
            "en": "I am learning Yakut."
          }
        },
        {
          "sah": "Сахалыы саҥараҕын дуо?",
          "tr": {
            "ru": "Ты говоришь по-якутски?",
            "en": "Do you speak Yakut?"
          }
        }
      ]
    },
