  "sections": [
    {
      "id": "letters",
      "title": "Буквы якутского алфавита",
      "subtitle": "Звуки, которых нет в русском",
      "items": [
        {
          "sah": "Ҕ ҕ",
          "ru": "аҕа — отец",
          "hint": "Мягкое «г», как в украинском или южнорусском «ага»"
        },
        {
          "sah": "Ҥ ҥ",
          "ru": "тииҥ — белка",
          "hint": "Носовое «нг», как в английском «sing»"
        },
        {
          "sah": "Ө ө",
          "ru": "өрүс — река",
          "hint": "Как «ё», но губы округлены сильнее; немецкое «ö»"
        },
        {
          "sah": "Ү ү",
          "ru": "үүт — молоко",
          "hint": "Как «ю», но губы вытянуты вперёд; немецкое «ü»"
        },
        {
          "sah": "Һ һ",
          "ru": "киһи — человек",
          "hint": "Лёгкое придыхание, как английское «h»"
        },
        {
          "sah": "иэ",
          "ru": "биэс — пять",
          "hint": "Дифтонг: два звука сливаются в один слог"
        },
        {
          "sah": "ыа",
          "ru": "ыал — семья, хозяйство",
          "hint": "Дифтонг"
        },
        {
          "sah": "уо",
          "ru": "уол — мальчик, сын",
          "hint": "Дифтонг"
        },
        {
          "sah": "үө",
          "ru": "үөрэх — учёба",
          "hint": "Дифтонг"
        },
        {
          "sah": "аа",
          "ru": "аат — имя",
          "hint": "Долгие гласные пишутся двумя буквами и меняют смысл слова"
        }
      ]
    },
