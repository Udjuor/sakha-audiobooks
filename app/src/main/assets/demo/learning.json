{
  "version": 2,
  "is_demo": true,
  "sections": [
    {
      "id": "letters",
      "title": {
        "ru": "Буквы якутского алфавита",
        "en": "Letters of the Yakut alphabet"
      },
      "items": [
        {
          "sah": "Ҕ ҕ",
          "tr": {
            "ru": "аҕа — отец",
            "en": "аҕа — father"
          },
          "hint": {
            "ru": "Мягкое «г», как в украинском или южнорусском «ага»",
            "en": "A soft fricative «g», like the Spanish «g» in «agua»"
          }
        },
        {
          "sah": "Ҥ ҥ",
          "tr": {
            "ru": "тииҥ — белка",
            "en": "тииҥ — squirrel"
          },
          "hint": {
            "ru": "Носовое «нг», как в английском «sing»",
            "en": "A nasal «ng», as in English «sing»"
          }
        },
        {
          "sah": "Ө ө",
          "tr": {
            "ru": "өрүс — река",
            "en": "өрүс — river"
          },
          "hint": {
            "ru": "Как «ё», но губы округлены сильнее; немецкое «ö»",
            "en": "Like German «ö»: say «e» with rounded lips"
          }
        },
        {
          "sah": "Ү ү",
          "tr": {
            "ru": "үүт — молоко",
            "en": "үүт — milk"
          },
          "hint": {
            "ru": "Как «ю», но губы вытянуты вперёд; немецкое «ü»",
            "en": "Like German «ü»: say «i» with rounded lips"
          }
        },
        {
          "sah": "Һ һ",
          "tr": {
            "ru": "киһи — человек",
            "en": "киһи — person"
          },
          "hint": {
            "ru": "Лёгкое придыхание, как английское «h»",
            "en": "A light breath, like English «h»"
          }
        },
        {
          "sah": "иэ",
          "tr": {
            "ru": "биэс — пять",
            "en": "биэс — five"
          },
          "hint": {
            "ru": "Дифтонг: два звука сливаются в один слог",
            "en": "Diphthong: two sounds merge into one syllable"
          }
        },
        {
          "sah": "ыа",
          "tr": {
            "ru": "ыал — семья, хозяйство",
            "en": "ыал — family, household"
          },
          "hint": {
            "ru": "Дифтонг",
            "en": "Diphthong"
          }
        },
        {
          "sah": "уо",
          "tr": {
            "ru": "уол — мальчик, сын",
            "en": "уол — boy, son"
          },
          "hint": {
            "ru": "Дифтонг",
            "en": "Diphthong"
          }
        },
        {
          "sah": "үө",
          "tr": {
            "ru": "үөрэх — учёба",
            "en": "үөрэх — learning"
          },
          "hint": {
            "ru": "Дифтонг",
            "en": "Diphthong"
          }
        }
      ],
      "subtitle": {
        "ru": "Звуки, которых нет в русском",
        "en": "Sounds that Russian doesn't have"
      }
    },
    {
      "id": "vowels",
      "title": {
        "ru": "Аһаҕас доргооннор — гласные",
        "en": "Аһаҕас доргооннор — vowels"
      },
      "items": [
        {
          "sah": "аа",
          "tr": {
            "ru": "аат — имя; хаар — снег",
            "en": "аат — name; хаар — snow"
          }
        },
        {
          "sah": "ээ",
          "tr": {
            "ru": "ээх — да (согласие)",
            "en": "ээх — yes (agreement)"
          }
        },
        {
          "sah": "ыы",
          "tr": {
            "ru": "кыыс — девушка; кыыл — зверь",
            "en": "кыыс — girl; кыыл — wild animal"
          }
        },
        {
          "sah": "ии",
          "tr": {
            "ru": "тииҥ — белка; киис — соболь",
            "en": "тииҥ — squirrel; киис — sable"
          }
        },
        {
          "sah": "оо",
          "tr": {
            "ru": "оонньуу — игра",
            "en": "оонньуу — game, play"
          }
        },
        {
          "sah": "уу",
          "tr": {
            "ru": "уу — вода",
            "en": "уу — water"
          }
        },
        {
          "sah": "өө",
          "tr": {
            "ru": "көрөөт — увидев",
            "en": "көрөөт — having seen"
          }
        },
        {
          "sah": "үү",
          "tr": {
            "ru": "үүт — молоко",
            "en": "үүт — milk"
          }
        }
      ],
      "subtitle": {
        "ru": "Долгие (двойные) гласные: пишутся двумя буквами и меняют смысл слова",
        "en": "Long (double) vowels: written with two letters, they change the meaning of a word"
      }
    },
    {
      "id": "consonants",
      "title": {
        "ru": "Бүтэй доргооннор — согласные",
        "en": "Бүтэй доргооннор — consonants"
      },
      "items": [
        {
          "sah": "кк",
          "tr": {
            "ru": "икки — два",
            "en": "икки — two"
          }
        },
        {
          "sah": "тт",
          "tr": {
            "ru": "сэттэ — семь",
            "en": "сэттэ — seven"
          }
        },
        {
          "sah": "нн",
          "tr": {
            "ru": "уонна — и",
            "en": "уонна — and"
          }
        },
        {
          "sah": "лл",
          "tr": {
            "ru": "аллайар — вскрикивает",
            "en": "аллайар — cries out"
          }
        },
        {
          "sah": "чч",
          "tr": {
            "ru": "ыччат — молодёжь, потомки",
            "en": "ыччат — youth, descendants"
          }
        }
      ],
      "subtitle": {
        "ru": "Двойные согласные: произносятся долго, с задержкой",
        "en": "Double consonants: pronounced long, with a slight hold"
      }
    },
    {
      "id": "greetings",
      "title": {
        "ru": "Приветствие и прощание",
        "en": "Greetings and goodbyes"
      },
      "items": [
        {
          "sah": "Нөргү!",
          "tr": {
            "ru": "Привет!",
            "en": "Hi!"
          }
        },
        {
          "sah": "Эҕэрдэ!",
          "tr": {
            "ru": "Приветствую!",
            "en": "Greetings!"
          }
        },
        {
          "sah": "Үтүө сарсыарданан!",
          "tr": {
            "ru": "Доброе утро!",
            "en": "Good morning!"
          }
        },
        {
          "sah": "Үтүө киэһэнэн!",
          "tr": {
            "ru": "Добрый вечер!",
            "en": "Good evening!"
          }
        },
        {
          "sah": "Кэпсээ!",
          "tr": {
            "ru": "Рассказывай! (что нового?)",
            "en": "Tell me! (what's new?)"
          },
          "hint": {
            "ru": "Традиционное начало разговора у якутов",
            "en": "A traditional Yakut way to start a conversation"
          }
        },
        {
          "sah": "Көрсүөххэ диэри!",
          "tr": {
            "ru": "До свидания!",
            "en": "Goodbye!"
          }
        }
      ]
    },
    {
      "id": "polite",
      "title": {
